{
  "name": "publicdebt",
  "version": "0.1.0",
  "private": true,
  "description": "Open-data platform for exploring public debt across the European Union.",
  "type": "module",
  "scripts": {
    "fetch:eurostat": "node src/pipeline.js fetch:eurostat",
    "fetch:population": "node src/pipeline.js fetch:population",
    "transform:eurostat": "node src/transform/debt.js",
    "transform:population": "node src/transform/population.js",
    "transform:eu": "node src/transform/eu.js",
    "transform:overview": "node src/transform/overview.js",
    "validate": "node src/validate/overview.js",
    "validate:countries": "node src/validate/countries.js",
    "validate:all": "npm run validate && npm run validate:countries && npm run validate:interest-rates && npm run validate:consistency",
    "audit:countries": "node src/validate/audit-countries.js",
    "validate:build": "SITE_ENV=production node src/validate/build.js",
    "validate:build:stage": "SITE_ENV=stage node src/validate/build.js",
    "validate:links": "node src/validate/links.js",
    "fetch": "node src/pipeline.js fetch",
    "transform": "node src/pipeline.js transform",
    "start": "node src/server/index.js",
    "update": "node src/pipeline.js update",
    "build": "SITE_ENV=production node src/build.js",
    "build:stage": "SITE_ENV=stage node src/build.js",
    "release": "npm run update && npm run build",
    "release:stage": "npm run update && npm run build:stage",
    "social": "node src/social/generate.js",
    "fetch:interest-rates": "node src/pipeline.js fetch:interest-rates",
    "transform:interest-rates": "node src/transform/interest-rates.js",
    "validate:interest-rates": "node src/validate/interest-rates.js",
    "validate:consistency": "node src/validate/consistency.js"
  },
  "homepage": "https://publicdebt.eu",
  "repository": {
    "type": "git",
    "url": "https://github.com/getpods/publicdebt.eu.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
